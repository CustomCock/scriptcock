# Kopiere diese Datei nach .env und passe die Werte an.

# Zufälliger, geheimer Schlüssel für Session-Cookies (z. B. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
APP_SECRET_KEY=bitte-aendern

# SQLite-Datenbank
DATABASE_URL=sqlite:///./data/baukasten.db

# Pfad-Präfix, falls die Anwendung hinter nginx unter einem Unterpfad läuft (z. B. /baukasten), sonst leer
ROOT_PATH=

# Session-Cookie nur über HTTPS senden (hinter nginx mit TLS: true)
SESSION_COOKIE_SECURE=true

# --- Anmeldung über Keycloak (OIDC) ---
OIDC_ISSUER=https://keycloak.okm.local/realms/okm
OIDC_CLIENT_ID=script-baukasten
OIDC_CLIENT_SECRET=
# Nur Mitglieder dieser Gruppe dürfen den Baukasten nutzen (leer = alle angemeldeten Benutzer)
OIDC_ERLAUBTE_GRUPPE=script-baukasten
# Mitglieder dieser Gruppe sind Admins (Rezepte freigeben, rote Blöcke ohne Zusatzbestätigung)
OIDC_ADMIN_GRUPPE=script-baukasten-admin
# Claim, in dem Keycloak die Gruppen liefert (Mapper "Group Membership")
OIDC_GRUPPEN_CLAIM=groups

# --- NUR für die lokale Entwicklung ---
# Schaltet die Anmeldung ab; die UI zeigt dann ein rotes Warnbanner.
AUTH_DISABLED=false
DEV_BENUTZER=entwickler
DEV_ADMIN=true
